<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chúc mừng ngày Phụ nữ Việt Nam 20/10</title>
    <style>
      :root {
        --pink: #ff5c9d;
        --deep: #2a0a24;
        --card: #ffffffe6;
        --ink: #4a1238;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        font-family: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background: var(--deep);
        color: #fff;
        overflow-x: hidden;
      }

      #sec-video {
        position: relative;
        height: 100vh;
        background: #000;
      }
      #intro-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      #unmute,
      #playbtn {
        position: absolute;
        border: 0;
        border-radius: 999px;
        cursor: pointer;
        font-size: 15px;
        background: #ffffffdd;
        color: #222;
        padding: 10px 16px;
      }
      #unmute {
        right: 16px;
        top: 16px;
      }
      #playbtn {
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        display: none;
        background: var(--pink);
        color: #fff;
        font-size: 18px;
        padding: 16px 28px;
      }
      .hint {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 22px;
        text-align: center;
        font-size: 15px;
        text-shadow: 0 2px 8px #000;
        animation: bob 1.6s ease-in-out infinite;
        pointer-events: none;
      }
      @keyframes bob {
        50% {
          transform: translateY(8px);
        }
      }

      #sec-name {
        min-height: 100vh;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: radial-gradient(circle at 50% 30%, #6b1b55, var(--deep));
      }
      #skip {
        position: absolute;
        right: 16px;
        bottom: 16px;
        border: 0;
        border-radius: 999px;
        padding: 8px 14px;
        background: #ffffff55;
        color: #fff;
        cursor: pointer;
      }
      .hint {
        display: none;
      }
      .core {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #fff;
        box-shadow: 0 0 40px #ff5c9d;
      }
      .box {
        background: var(--card);
        color: var(--ink);
        border-radius: 22px;
        padding: 34px 28px;
        max-width: 430px;
        width: 100%;
        text-align: center;
        box-shadow: 0 14px 50px #0008;
      }
      .box h2 {
        font-size: 26px;
        color: #d6246e;
        margin-bottom: 8px;
      }
      .box p {
        margin-bottom: 18px;
        line-height: 1.5;
      }
      .box input {
        width: 100%;
        padding: 13px 14px;
        font-size: 17px;
        text-align: center;
        border: 2px solid #f0b3d0;
        border-radius: 12px;
        outline: none;
        background: #fff;
        color: var(--ink);
      }
      .box input:focus {
        border-color: var(--pink);
      }
      .box button {
        margin-top: 14px;
        width: 100%;
        padding: 13px;
        font-size: 17px;
        border: 0;
        border-radius: 12px;
        background: var(--pink);
        color: #fff;
        cursor: pointer;
      }
      #err {
        min-height: 22px;
        margin-top: 10px;
        color: #b00020;
        font-size: 14px;
      }
      .shake {
        animation: shake 0.4s;
      }
      @keyframes shake {
        25% {
          transform: translateX(-8px);
        }
        75% {
          transform: translateX(8px);
        }
      }

      #sec-sphere {
        display: none;
        position: relative;
        height: 100vh;
        overflow: hidden;
        background: radial-gradient(
          circle at 50% 50%,
          #7a1f61 0%,
          #3a0f33 55%,
          #1a0516 100%
        );
      }

      .bg {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        overflow: hidden;
      }
      .row {
        white-space: nowrap;
        overflow: hidden;
        font-weight: 600;
        color: #ffb3d3;
      }
      .row span {
        display: inline-block;
        animation: marquee linear infinite;
      }
      .row.rev span {
        animation-direction: reverse;
      }
      @keyframes marquee {
        to {
          transform: translateX(-50%);
        }
      }

      .title {
        position: absolute;
        top: 3%;
        left: 0;
        right: 0;
        text-align: center;
        z-index: 5;
        pointer-events: none;
        font-size: clamp(22px, 4.2vw, 42px);
        font-weight: 800;
        color: #fff;
        text-shadow:
          0 0 18px #ff5c9d,
          0 2px 0 #00000066;
      }
      .stage {
        position: absolute;
        inset: 0;
        z-index: 3;
        perspective: 1100px;
        display: flex;
        align-items: center;
        justify-content: center;
        touch-action: pan-y;
        cursor: grab;
      }
      .stage:active {
        cursor: grabbing;
      }
      .sphere {
        position: relative;
        width: 0;
        height: 0;
        transform-style: preserve-3d;
      }
      .tile {
        position: absolute;
        left: 50%;
        top: 50%;
        object-fit: cover;
        border-radius: 10px;
        border: 3px solid #fff;
        backface-visibility: hidden;
        background: #fff;
        box-shadow: 0 0 18px #ff5c9d99;
        user-select: none;
        -webkit-user-drag: none;
      }
      .glow {
        position: absolute;
        left: 50%;
        top: 50%;
        width: min(70vw, 70vh);
        aspect-ratio: 1;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        z-index: 2;
        pointer-events: none;
        background: radial-gradient(circle, #ff5c9d55, transparent 65%);
      }

      .fall {
        position: fixed;
        top: -30px;
        pointer-events: none;
        z-index: 9;
        animation: fall linear forwards;
      }
      @keyframes fall {
        to {
          transform: translateY(110vh) rotate(360deg);
        }
      }
    </style>
  </head>
  <body>
    <section id="sec-video">
      <video id="intro-video" autoplay muted playsinline preload="auto"></video>
      <button id="unmute">🔊 Bật tiếng</button>
      <button id="playbtn">▶ Bấm để xem</button>
      <button id="skip">Bỏ qua ⏭</button>
      <div class="hint" id="hint">Kéo xuống để nhận quà ⬇</div>
    </section>

    <section id="sec-name">
      <div class="box" id="namebox">
        <h2>🌹 Chúc mừng 20/10 🌹</h2>
        <p>Hãy nhập tên của bạn để mở món quà nhỏ nhé!</p>
        <input
          id="name-input"
          type="text"
          placeholder="Nhập tên của bạn…"
          autocomplete="off"
        />
        <button id="name-btn">Mở quà</button>
        <div id="err"></div>
      </div>
    </section>

    <section id="sec-sphere">
      <div class="bg" id="bg"></div>
      <button
        id="back"
        style="
          position: absolute;
          left: 14px;
          bottom: 14px;
          z-index: 6;
          border: 0;
          border-radius: 999px;
          padding: 8px 14px;
          background: #ffffff55;
          color: #fff;
          cursor: pointer;
        "
      >
        ← Nhập tên khác
      </button>
      <div class="glow"></div>
      <div class="title" id="title"></div>
      <div class="stage" id="stage">
        <img class="core" id="core" alt="" />
        <div class="sphere" id="sphere"></div>
      </div>
    </section>

    <script>
      const CONFIG = {
        VIDEO_SRC:
          "data:video/mp4;base64,",

        PEOPLE: [
          {
            name: "Ngô Thị Thảo Linh",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Nguyễn Thị Hồng Ánh",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Nguyễn Thị Thương",
            imgs: [
              "data:image/jpeg;base64,",
              "data:image/jpeg;base64,",
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Nguyễn Thị Trang",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Nguyễn Thị Yến Nhi",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Nguyễn Trần Ngọc Anh",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Phạm Thị Anh Thư",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Phạm Thị Mây",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Phạm Thuỳ Dung",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Trần Thảo Nguyên",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Trần Thị Lệ Na",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Mai Thị Thùy Trang",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Đinh Thị Bảo Khánh",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Trần Thị Hằng",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Dương Thị Thu Hằng",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Đặng Thị Thùy Trâm",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Lê Thị Uyển Nhi",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Giản Thu Thủy",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Lương Yến Nhi",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
          {
            name: "Bùi Ngọc Hân",
            imgs: [
              "data:image/jpeg;base64,",
            ],
          },
        ],

        TITLE: "Chúc mừng 20/10, {name}! 🌹",

        WISHES: [
          "Nhân ngày 20/10 chúc các bông hoa 11c3 luôn vui vẻ xinh đẹp và hc thật tốt 💐",
          "Chúc các câu một ngày 20/10 thật hạnh phúc, luôn tươi vui và đạt nhiều điều tốt đẹp 🌸",
          "Chúc các bn ngày càng xinh đẹp duyên dáng và ngày càng rạng rỡ hơn và gặp nhiều may mắn 😊",
          "Cảm ơn bạn vì đã luôn dịu dàng và mạnh mẽ 💖",
          "Chúc bạn sức khỏe, bình an và thành công ✨",
          "Chúc tập thể lớp ngày càng đi lên và nhiều điều tốt đẹp sẽ đến với tập thể lớp 11c3🌹",
          "Bạn xứng đáng được yêu thương thật nhiều 🥰",
          "20/10 vui vẻ nhé! 🎀",
        ],

        SPHERE_TILES: 28,
        AUTO_SPEED: 0.25,
        ERROR_MSG: "Tên chưa đúng, bạn thử lại nhé!",
      };

      const $ = (id) => document.getElementById(id);

      const norm = (s) =>
        s
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/đ/gi, "d")
          .toLowerCase()
          .replace(/\s+/g, " ")
          .trim();

      const video = $("intro-video");
      const toBlobUrl = (src) => {
        if (!src.startsWith("data:")) return src;
        const bin = atob(src.split(",")[1]);
        const arr = new Uint8Array(bin.length);
        for (let i = 0; i < bin.length; i++) arr[i] = bin.charCodeAt(i);
        return URL.createObjectURL(new Blob([arr], { type: "video/mp4" }));
      };
      video.src = toBlobUrl(CONFIG.VIDEO_SRC);
      video.controls = false;
      video.addEventListener("error", () => {
        $("playbtn").textContent = "⚠ Không phát được video";
        $("playbtn").style.display = "block";
      });

      video.play().catch(() => {
        $("playbtn").style.display = "block";
      });
      $("playbtn").onclick = () => {
        video.muted = false;
        video.play();
        $("playbtn").style.display = "none";
        $("unmute").style.display = "none";
      };
      $("unmute").onclick = () => {
        video.muted = false;
        $("unmute").style.display = "none";
      };

      let revealed = false;
      function revealName() {
        if (revealed) return;
        revealed = true;
        $("skip").style.display = "none";
        $("sec-name").style.display = "flex";
        $("hint").style.display = "block";
        setTimeout(
          () => $("sec-name").scrollIntoView({ behavior: "smooth" }),
          600,
        );
      }
      video.addEventListener("ended", revealName);
      $("skip").onclick = revealName;

      // ảnh dự phòng khi chưa có file ảnh
      const ph = (i) =>
        "data:image/svg+xml," +
        encodeURIComponent(
          '<svg xmlns="http://www.w3.org/2000/svg" width="200" height="230"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="' +
            ["#ff5c9d", "#ff8fb8", "#d6246e"][i % 3] +
            '"/><stop offset="1" stop-color="#7a1f61"/></linearGradient></defs><rect width="200" height="230" fill="url(#g)"/><text x="100" y="135" font-size="64" text-anchor="middle">💖</text></svg>',
        );
      const safeImg = (img, i) => {
        img.onerror = () => {
          img.onerror = null;
          img.src = ph(i);
        };
      };

      function submitName() {
        const raw = $("name-input").value;
        const person = (
          CONFIG.PEOPLE.find((p) => norm(p.name) === norm(raw)) || {}
        ).name;
        if (!person) {
          $("err").textContent = CONFIG.ERROR_MSG;
          const b = $("namebox");
          b.classList.remove("shake");
          void b.offsetWidth;
          b.classList.add("shake");
          return;
        }
        openGift(person);
      }
      $("name-btn").onclick = submitName;
      $("name-input").addEventListener("keydown", (e) => {
        if (e.key === "Enter") submitName();
      });

      let fallingOn = false;
      function photo(img, name, i) {
        const person = CONFIG.PEOPLE.find((p) => p.name === name);
        img.onerror = () => {
          img.onerror = null;
          img.src = ph(i);
        };
        img.src = person.imgs[i % person.imgs.length];
      }

      function openGift(name) {
        $("sec-sphere").style.display = "block";
        $("title").textContent = CONFIG.TITLE.replace("{name}", name);
        buildBackground();
        buildSphere(name);
        $("sec-sphere").scrollIntoView({ behavior: "smooth" });
        if (!fallingOn) {
          fallingOn = true;
          startFalling();
        }
      }
      $("back").onclick = () => {
        $("name-input").value = "";
        $("err").textContent = "";
        $("sec-name").scrollIntoView({ behavior: "smooth" });
        setTimeout(() => ($("sec-sphere").style.display = "none"), 700);
      };

      function buildBackground() {
        const bg = $("bg");
        bg.innerHTML = "";
        const base = CONFIG.WISHES.join("   ✿   ") + "   ✿   ";
        const block = base.repeat(3);
        const rows = 9;
        for (let i = 0; i < rows; i++) {
          const row = document.createElement("div");
          row.className = "row" + (i % 2 ? " rev" : "");
          row.style.fontSize = 16 + (i % 3) * 5 + "px";
          row.style.opacity = (0.35 + (i % 3) * 0.2).toFixed(2);
          const span = document.createElement("span");
          span.textContent = block + block;
          span.style.animationDuration = 50 + i * 9 + "s";
          span.style.animationDelay = -i * 7 + "s";
          row.appendChild(span);
          bg.appendChild(row);
        }
      }

      let rx = -10,
        ry = 0,
        vel = CONFIG.AUTO_SPEED,
        dragging = false,
        lastX = 0,
        inited = false;
      function buildSphere(name) {
        const sphere = $("sphere");
        sphere.innerHTML = "";
        const N = CONFIG.SPHERE_TILES;
        const R =
          Math.min(innerWidth, innerHeight) * (innerWidth < 700 ? 0.33 : 0.3);
        const size = R * 0.55;
        const core = $("core");
        core.style.width = core.style.height = R * 1.15 + "px";
        photo(core, name, 0);
        const golden = Math.PI * (3 - Math.sqrt(5));
        for (let i = 0; i < N; i++) {
          const lat = Math.asin(1 - (2 * (i + 0.5)) / N);
          const lon = golden * i;
          const img = document.createElement("img");
          img.className = "tile";
          img.alt = "";
          img.draggable = false;
          photo(img, name, i);
          img.style.width = size + "px";
          img.style.height = size * 1.15 + "px";
          img.style.margin = -size * 0.575 + "px 0 0 " + -size / 2 + "px";
          img.style.transform =
            "rotateY(" +
            lon +
            "rad) rotateX(" +
            lat +
            "rad) translateZ(" +
            R +
            "px)";
          sphere.appendChild(img);
        }
        if (inited) return;
        inited = true;
        $("stage").addEventListener("pointerdown", (e) => {
          dragging = true;
          lastX = e.clientX;
        });
        addEventListener("pointerup", () => (dragging = false));
        addEventListener("pointermove", (e) => {
          if (!dragging) return;
          vel = (e.clientX - lastX) * 0.4;
          lastX = e.clientX;
        });
        (function loop() {
          if (!dragging) vel += (CONFIG.AUTO_SPEED - vel) * 0.03;
          ry += vel;
          sphere.style.transform =
            "rotateX(" + rx + "deg) rotateY(" + ry + "deg)";
          requestAnimationFrame(loop);
        })();
      }

      function startFalling() {
        const icons = ["🌸", "🌷", "💖", "🌹", "✨", "🎀"];
        setInterval(() => {
          const f = document.createElement("div");
          f.className = "fall";
          f.textContent = icons[Math.floor(Math.random() * icons.length)];
          f.style.left = Math.random() * 100 + "vw";
          f.style.fontSize = 16 + Math.random() * 18 + "px";
          f.style.animationDuration = 5 + Math.random() * 5 + "s";
          document.body.appendChild(f);
          setTimeout(() => f.remove(), 11000);
        }, 500);
      }
    </script>
  </body>
</html>
